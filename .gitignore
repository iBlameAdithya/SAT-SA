# ==============================================================================
# SAT-SA (.gitignore) — National Critical Infrastructure Protection Centre
# Clean repository configuration for Tauri v2 + Rust + React/TypeScript
# ==============================================================================

# Node dependencies & package manager
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production frontend build outputs
dist/
dist-ssr/
*.local

# Tauri & Rust compilation artifacts (CRITICAL: prevents gigabytes of target binaries)
src-tauri/target/
target/
**/*.rs.bk
*.pdb

# Temporary and local test SQLite databases
*.db
*.db-journal
*.db-wal
*.db-shm
src-tauri/*.db
src-tauri/*.db-journal
src-tauri/*.db-wal
src-tauri/*.db-shm
satsa_tauri.db

# Generated export reports and sample exports
src-tauri/exports/

# Playwright, E2E test runs & frame captures
.playwright-mcp/
test-results/
playwright-report/
blob-report/
e2e_*.png
frame_*.jpg
frame_*.png

# Video recording binaries & OBS automation (Keep videos on Google Drive / YouTube)
videos/
*.webm
*.mkv
*.mp4
record_demo_video.js
record_with_obs.js
test_obs_ws.js
run_playwright_test.js

# Python scratchpad generation & calibration scripts
__pycache__/
*.py[cod]
*$py.class
*.py
abstract
description

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment variables & developer overrides
.env
.env.*
!.env.example

# IDE & Editor caches
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
